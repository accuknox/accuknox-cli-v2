{
    "rabbit_version": "3.8.9",
    "users": [
      {
        "name": "{{.RMQUsername}}",
        "password_hash": "{{.RMQPasswordHash}}",
        "hashing_algorithm": "rabbit_password_hashing_sha256",
        "tags": "administrator"
      }
    ],
    "vhosts": [
      {
        "name": "/"
      }
    ],
    "permissions": [
      {
        "user": "{{.RMQUsername}}",
        "vhost": "/",
        "configure": ".*",
        "write": ".*",
        "read": ".*"
      }
    ]
  }
  